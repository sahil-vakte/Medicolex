# Public site URL (used for canonical URLs, sitemap and structured data)
NEXT_PUBLIC_SITE_URL=https://www.medicolex.co.uk

# Optional: Google Analytics 4 measurement ID. Only loads after the visitor accepts analytics cookies.
NEXT_PUBLIC_GA_ID=

# Form delivery. Leave blank in development: submissions are logged to the server console only.
# Set FORM_WEBHOOK_URL to a secure HTTPS endpoint (CRM, Zapier/Make, or your own API) that accepts JSON.
FORM_WEBHOOK_URL=
FORM_WEBHOOK_SECRET=
